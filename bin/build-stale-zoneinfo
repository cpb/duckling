#!/usr/bin/env bash
# Builds a zoneinfo directory that is system-shaped and stale: copies the
# host's zoneinfo directory and compiles test/fixtures/zoneinfo-overrides/*.zi
# over it, rolling named zones back to earlier rules. The copy keeps the
# host's modelling and links state. The environment's contract is
# test/environments/stale_vintage_test.rb. See docs/tz-database-axis.md.
#
# Usage: bin/build-stale-zoneinfo <output-dir>
#   ZONEINFO_DIR  source directory to copy (default /usr/share/zoneinfo)
set -euo pipefail

out="${1:?usage: bin/build-stale-zoneinfo <output-dir>}"
source_dir="${ZONEINFO_DIR:-/usr/share/zoneinfo}"
overrides="$(cd "$(dirname "$0")/.." && pwd)/test/fixtures/zoneinfo-overrides"

# zic lives in sbin, which is not on a non-root PATH.
export PATH="$PATH:/usr/sbin:/sbin"

if [ ! -d "$source_dir" ]; then
  echo "build-stale-zoneinfo: no zoneinfo directory at $source_dir" >&2
  exit 1
fi

rm -rf "$out"
mkdir -p "$out"

# -L dereferences the alias symlinks, so an override writes a real file
# rather than following a link back into the host's directory.
cp -RL "$source_dir/." "$out/"

for zi in "$overrides"/*.zi; do
  zic -b fat -d "$out" "$zi"
done

echo "build-stale-zoneinfo: wrote $out from $source_dir with overrides from $overrides"
